    {
      "key": "sleep_scored",
      "label": {
        "en": "WHOOP: sleep scored",
        "fr": "WHOOP : sommeil calculé",
        "de": "WHOOP: Schlaf berechnet",
        "es": "WHOOP: sueño calculado"
      },
      "description": {
        "en": "WHOOP scored a new sleep or nap. Seen at the next reading.",
        "fr": "WHOOP a calculé un nouveau sommeil ou une sieste. Vu à la lecture suivante.",
        "de": "WHOOP hat einen neuen Schlaf oder ein Nickerchen berechnet. Bei der nächsten Abfrage erkannt.",
