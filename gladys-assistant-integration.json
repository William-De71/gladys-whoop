            "fr": "Récupération (%)",
            "de": "Erholung (%)",
            "es": "Recuperación (%)"
          }
        },
        {
          "key": "zone",
          "type": "string",
          "label": {
            "en": "Zone (green, yellow, red)",
            "fr": "Zone (green, yellow, red)",
            "de": "Zone (green, yellow, red)",
            "es": "Zona (green, yellow, red)"
          }
        },
        {
          "key": "zone_label",
          "type": "string",
          "label": {
