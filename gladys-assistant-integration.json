      },
      "fields": [
        {
          "key": "member",
          "type": "select",
          "source": "devices",
          "required": false,
          "label": {
            "en": "WHOOP member",
            "fr": "Membre WHOOP",
            "de": "WHOOP-Mitglied",
            "es": "Miembro WHOOP"
          },
          "description": {
            "en": "Leave empty for any member.",
            "fr": "Laissez vide pour tous les membres.",
            "de": "Leer lassen für jedes Mitglied.",
            "es": "Déjelo vacío para cualquier miembro."
